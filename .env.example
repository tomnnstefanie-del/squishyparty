# Copy to .env.local for local testing. On Vercel, add these under Project → Settings → Environment Variables.
# Never put these in the page or commit them to git.
TELEGRAM_BOT_TOKEN=123456789:replace-with-the-token-from-BotFather
TELEGRAM_CHAT_ID=-1001234567890
# Email (codes + confirmation): a Gmail address and its 16-letter app password
SMTP_USER=your-confetti-club-address@gmail.com
SMTP_PASS=replace-with-app-password
# Only for tests: write emails to dev/.mailbox.json, and use the mock Telegram server
# MAIL_TRANSPORT=file
# TELEGRAM_API_BASE=http://localhost:8789

# Referral dashboard (/admin.html)
# Password to open it (8+ characters). Without it the dashboard stays locked.
ADMIN_PASSWORD=
# Database for the numbers: in Vercel, Storage -> Create -> Upstash for Redis (free), connect to this project.
# That sets these two for you; you don't need to copy them anywhere.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Daily 9am Telegram to-do list (vercel.json crons). Any long random text, 16+ characters; Vercel sends it to /api/digest.
CRON_SECRET=
