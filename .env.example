# Copy to .env.local for local testing. On Vercel, add these under Project → Settings → Environment Variables.
# Never put these in the page or commit them to git.
TELEGRAM_BOT_TOKEN=123456789:replace-with-the-token-from-BotFather
TELEGRAM_CHAT_ID=-1001234567890
# Email (codes + confirmation): a Gmail address and its 16-letter app password
SMTP_USER=squishyparty.sg@gmail.com
SMTP_PASS=replace-with-app-password
# PayNow for the 10% holding deposit: UEN (business) or PAYNOW_MOBILE
PAYNOW_UEN=53123456X
PAYNOW_NAME=Tom & Stefanie
# Only for tests: write emails to dev/.mailbox.json, and use the mock Telegram server
# MAIL_TRANSPORT=file
# TELEGRAM_API_BASE=http://localhost:8789
