{
  "name": "squishy-party-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Squishy Party by Tom & Stefanie: party planner website + request API (Telegram, email code).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node dev/build.mjs",
    "preview": "node dev/build.mjs --preview",
    "dev": "node dev/server.mjs",
    "catalogue": "node dev/extract-catalogue.mjs public/index.html lib/catalogue.js",
    "test": "node tests/unit.mjs && node tests/e2e.mjs",
    "test:click": "node dev/build.mjs --preview && node tests/clickthrough.mjs",
    "check": "npm run build && npm run catalogue && npm test && npm run test:click",
    "chat-id": "node dev/get-chat-id.mjs"
  },
  "dependencies": {
    "nodemailer": "10.0.16"
  },
  "devDependencies": {
    "playwright": "1.55.1"
  }
}
